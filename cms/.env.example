# =================================================================
# Strapi CMS Configuration for karstenwade.com
# =================================================================
# Copy this file to .env and replace all placeholder values.
# Use `npm run strapi:generate-secrets` to generate secure values.
# =================================================================

# Server Configuration
HOST=0.0.0.0
PORT=1337

# =================================================================
# SECURITY SECRETS (REQUIRED - Generate unique values for each!)
# Run: openssl rand -base64 32 for each secret
# =================================================================

# Application keys (comma-separated, at least 2 required)
APP_KEYS="key1-replace-with-openssl-rand-base64-32,key2-replace-with-openssl-rand-base64-32"

# API token salt (for generating API tokens)
API_TOKEN_SALT=replace-with-openssl-rand-base64-32

# Admin JWT secret (for admin panel authentication)
ADMIN_JWT_SECRET=replace-with-openssl-rand-base64-32

# Transfer token salt (for data transfer operations)
TRANSFER_TOKEN_SALT=replace-with-openssl-rand-base64-32

# JWT secret (for content API authentication)
JWT_SECRET=replace-with-openssl-rand-base64-32

# Encryption key (for encrypting sensitive data)
ENCRYPTION_KEY=replace-with-openssl-rand-base64-32

# =================================================================
# CORS Configuration
# =================================================================

# Allowed origins for CORS (comma-separated)
CORS_ORIGINS=http://localhost:3001,https://karstenwade.com

# =================================================================
# Admin Panel Configuration (Optional)
# =================================================================

# Admin JWT token expiration (default: 30d)
ADMIN_JWT_EXPIRES_IN=30d

# Rate limiting for admin login (requests per interval)
ADMIN_RATE_LIMIT_MAX=10
ADMIN_RATE_LIMIT_INTERVAL=60000

# Audit logs
ADMIN_AUDIT_LOGS=true
ADMIN_AUDIT_RETENTION_DAYS=90

# =================================================================
# ZeroDB Integration (Required for content sync)
# =================================================================

# ZeroDB API URL
ZERODB_API_URL=https://api.ainative.studio

# ZeroDB Project ID
ZERODB_PROJECT_ID=your-project-id

# ZeroDB credentials
ZERODB_USERNAME=your-username
ZERODB_PASSWORD=your-password
