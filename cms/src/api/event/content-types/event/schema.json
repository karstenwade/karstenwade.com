{
  "kind": "collectionType",
  "collectionName": "events",
  "info": {
    "singularName": "event",
    "pluralName": "events",
    "displayName": "Event",
    "description": "Manage webinars, workshops, meetups, and conferences"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "description": {
      "type": "richtext"
    },
    "short_description": {
      "type": "text",
      "maxLength": 300
    },
    "event_type": {
      "type": "enumeration",
      "enum": ["webinar", "workshop", "meetup", "conference", "hackathon", "training", "other"],
      "default": "meetup"
    },
    "start_date": {
      "type": "datetime",
      "required": true
    },
    "end_date": {
      "type": "datetime"
    },
    "timezone": {
      "type": "string",
      "default": "UTC"
    },
    "is_virtual": {
      "type": "boolean",
      "default": true
    },
    "location": {
      "type": "string"
    },
    "venue_name": {
      "type": "string"
    },
    "address": {
      "type": "text"
    },
    "city": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "virtual_url": {
      "type": "string"
    },
    "registration_url": {
      "type": "string"
    },
    "registration_deadline": {
      "type": "datetime"
    },
    "max_attendees": {
      "type": "integer",
      "min": 0
    },
    "current_attendees": {
      "type": "integer",
      "min": 0,
      "default": 0
    },
    "is_free": {
      "type": "boolean",
      "default": true
    },
    "price": {
      "type": "decimal"
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "cover": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "gallery": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": ["images", "videos"]
    },
    "organizer": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::author.author",
      "inversedBy": "events"
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::category.category",
      "inversedBy": "events"
    },
    "speakers": {
      "type": "json"
    },
    "agenda": {
      "type": "json"
    },
    "sponsors": {
      "type": "json"
    },
    "faq": {
      "type": "json"
    },
    "status": {
      "type": "enumeration",
      "enum": ["upcoming", "live", "completed", "cancelled", "postponed"],
      "default": "upcoming"
    },
    "recording_url": {
      "type": "string"
    },
    "resources": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": ["files", "images", "videos"]
    },
    "social_links": {
      "type": "json"
    },
    "custom_fields": {
      "type": "json"
    }
  }
}
