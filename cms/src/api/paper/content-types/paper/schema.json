{
  "kind": "collectionType",
  "collectionName": "papers",
  "info": {
    "singularName": "paper",
    "pluralName": "papers",
    "displayName": "Paper",
    "description": "Academic papers and theory documents synced from GitHub"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "description": {
      "type": "text",
      "maxLength": 300
    },
    "abstract": {
      "type": "text",
      "required": true
    },
    "content": {
      "type": "richtext"
    },
    "version": {
      "type": "string",
      "default": "1.0"
    },
    "publication_date": {
      "type": "date"
    },
    "last_updated": {
      "type": "date"
    },
    "github_path": {
      "type": "string"
    },
    "github_sha": {
      "type": "string"
    },
    "external_url": {
      "type": "string"
    },
    "pdf_url": {
      "type": "string"
    },
    "doi": {
      "type": "string"
    },
    "source": {
      "type": "enumeration",
      "enum": ["github-papers", "github-tosw", "manual"],
      "default": "manual"
    },
    "sync_locked": {
      "type": "boolean",
      "default": false
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "author": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::author.author",
      "inversedBy": "papers"
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::category.category",
      "inversedBy": "papers"
    },
    "tags": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::tag.tag",
      "inversedBy": "papers"
    }
  }
}
