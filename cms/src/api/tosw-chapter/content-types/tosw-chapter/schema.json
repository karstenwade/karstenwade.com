{
  "kind": "collectionType",
  "collectionName": "tosw_chapters",
  "info": {
    "singularName": "tosw-chapter",
    "pluralName": "tosw-chapters",
    "displayName": "TOSW Chapter",
    "description": "The Open Source Way guidebook chapters"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "description": {
      "type": "text",
      "maxLength": 500
    },
    "content": {
      "type": "richtext"
    },
    "section": {
      "type": "string",
      "required": true
    },
    "section_order": {
      "type": "integer",
      "min": 0,
      "default": 0
    },
    "chapter_order": {
      "type": "integer",
      "min": 0,
      "default": 0
    },
    "github_path": {
      "type": "string"
    },
    "github_sha": {
      "type": "string"
    },
    "external_url": {
      "type": "string"
    },
    "source": {
      "type": "enumeration",
      "enum": ["github-tosw", "manual"],
      "default": "github-tosw"
    },
    "sync_locked": {
      "type": "boolean",
      "default": false
    },
    "license": {
      "type": "string",
      "default": "CC BY-SA 4.0"
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::category.category",
      "inversedBy": "tosw_chapters"
    },
    "tags": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::tag.tag",
      "inversedBy": "tosw_chapters"
    }
  }
}
