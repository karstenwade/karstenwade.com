{
  "kind": "collectionType",
  "collectionName": "tags",
  "info": {
    "singularName": "tag",
    "pluralName": "tags",
    "displayName": "Tag",
    "description": "Tags for categorizing content"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "blog_posts": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::blog-post.blog-post",
      "mappedBy": "tags"
    },
    "tutorials": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::tutorial.tutorial",
      "mappedBy": "tags"
    },
    "tosw_chapters": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::tosw-chapter.tosw-chapter",
      "mappedBy": "tags"
    },
    "writings": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::writing.writing",
      "mappedBy": "tags"
    },
    "papers": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::paper.paper",
      "mappedBy": "tags"
    }
  }
}
