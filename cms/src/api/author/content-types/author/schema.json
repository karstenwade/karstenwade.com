{
  "kind": "collectionType",
  "collectionName": "authors",
  "info": {
    "singularName": "author",
    "pluralName": "authors",
    "displayName": "Author",
    "description": "Create authors for your content"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "avatar": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "email": {
      "type": "string"
    },
    "bio": {
      "type": "text"
    },
    "website": {
      "type": "string"
    },
    "social_links": {
      "type": "json"
    },
    "blog_posts": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::blog-post.blog-post",
      "mappedBy": "author"
    },
    "tutorials": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::tutorial.tutorial",
      "mappedBy": "author"
    },
    "events": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::event.event",
      "mappedBy": "organizer"
    },
    "writings": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::writing.writing",
      "mappedBy": "author"
    },
    "papers": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::paper.paper",
      "mappedBy": "author"
    },
    "poems": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::poem.poem",
      "mappedBy": "author"
    },
    "essays": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::essay.essay",
      "mappedBy": "author"
    },
    "stories": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::story.story",
      "mappedBy": "author"
    }
  }
}
