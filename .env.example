# =================================================================
# karstenwade.com Next.js Environment Variables
# =================================================================
# Copy this file to .env.local and replace placeholder values.
# =================================================================

# =================================================================
# Strapi CMS
# =================================================================

# Strapi API URL
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337

# Strapi API token (create in Strapi admin: Settings > API Tokens)
STRAPI_API_TOKEN=your-strapi-api-token

# =================================================================
# ZeroDB Semantic Search (Optional)
# =================================================================
# Enable semantic search for blog posts and tutorials.
# Get credentials from https://ainative.studio

# ZeroDB Project ID (public, can be exposed to client)
NEXT_PUBLIC_ZERODB_PROJECT_ID=your-project-id

# ZeroDB API URL (public)
NEXT_PUBLIC_ZERODB_API_URL=https://api.ainative.studio

# ZeroDB API Key (server-side only, do NOT expose to client)
ZERODB_API_KEY=your-api-key

# =================================================================
# Analytics (Optional)
# =================================================================

# Google Analytics Measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
